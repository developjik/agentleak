{
  "name": "@developjik/agentleak",
  "version": "0.1.0",
  "private": false,
  "description": "Audit what your site tells AI agents but hides from humans: hidden instructions, UA cloaking, and snapshot diffs.",
  "type": "module",
  "bin": {
    "agentleak": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "fixtures": "tsx src/fixtures/serve.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "scan:demo": "tsx src/cli.ts scan",
    "diff:demo": "tsx src/cli.ts diff",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "playwright": "^1.65.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developjik/agentleak.git"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ]
}
